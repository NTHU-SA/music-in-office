{
  "manifest_version": 3,
  "name": "Office Music Link",
  "version": "0.1.2",
  "description": "Connect YouTube Music tabs to the local Office Music Bot.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:18765/*", "https://music.youtube.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Office Music Link: open managed music tab"},
  "content_scripts": [{
    "matches": ["https://music.youtube.com/*"],
    "js": ["player.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:18765"
  }
}
