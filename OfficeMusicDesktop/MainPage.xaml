<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OfficeMusicDesktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="zh-TW"
    FontFamily="Microsoft JhengHei UI"
    Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="28,16,28,28" Spacing="16">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="辦公室點歌" Style="{ThemeResource TitleTextBlockStyle}"
                               FontFamily="Microsoft JhengHei UI"/>
                    <TextBlock Text="大家的點歌，這台電腦的音樂。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="24" Height="24" AutomationProperties.Name="正在處理"/>
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="22">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D6;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.PlaybackStatus, Mode=OneWay}"
                                   FontFamily="Microsoft JhengHei UI"
                                   AutomationProperties.AutomationId="PlaybackStatus"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.SongTitle, Mode=OneWay}"
                                   FontFamily="Microsoft JhengHei UI"
                                   AutomationProperties.AutomationId="SongTitle"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.SongArtist, Mode=OneWay}"
                                   AutomationProperties.AutomationId="SongArtist" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SongSource, Mode=OneWay}"
                               AutomationProperties.AutomationId="SongSource"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.QueueText, Mode=OneWay}"
                                   AutomationProperties.AutomationId="QueueCount"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AutoplayText, Mode=OneWay}"
                                   AutomationProperties.AutomationId="AutoplayStatus"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                           FontFamily="Microsoft JhengHei UI"
                           AutomationProperties.AutomationId="ConnectionStatus"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.ConnectionDetail, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="{x:Bind ViewModel.StartLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StartCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="StartButton"/>
                <Button Content="停止" Command="{x:Bind ViewModel.StopCommand}"
                        AutomationProperties.AutomationId="StopButton"/>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="YouTube 帳號" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="YouTube 登入" Command="{x:Bind ViewModel.LoginCommand}"
                            AutomationProperties.AutomationId="YouTubeLoginButton"/>
                    <Button Content="完成登入並關閉" Command="{x:Bind ViewModel.FinishLoginCommand}"
                            AutomationProperties.AutomationId="FinishLoginButton"/>
                </StackPanel>
                <TextBlock Text="請先載入 Office Music Link 擴充套件並保持 Chromium 開啟。專用分頁使用瀏覽器的登入狀態，Google 可能要求重新登入。"
                           TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}" Severity="Error"
                     Title="需要處理" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="ErrorInfoBar"/>

            <Expander Header="Discord 連線設定"
                      IsExpanded="{x:Bind ViewModel.SettingsExpanded, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="SettingsExpander">
                <StackPanel Spacing="14">
                    <PasswordBox Header="Bot Token" Password="{x:Bind ViewModel.Token, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                 PasswordRevealMode="Hidden" AutomationProperties.AutomationId="BotToken"
                                 AutomationProperties.Name="Discord Bot Token"/>
                    <TextBox Header="Server ID／伺服器 ID"
                             Text="{x:Bind ViewModel.GuildId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                             AutomationProperties.AutomationId="ServerId"
                             AutomationProperties.Name="伺服器 ID"
                             PlaceholderText="伺服器圖示按右鍵 → 複製伺服器 ID"/>
                    <TextBox Header="Channel ID／點歌頻道 ID"
                             Text="{x:Bind ViewModel.ChannelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                             AutomationProperties.AutomationId="ChannelId"
                             AutomationProperties.Name="點歌頻道 ID"
                             PlaceholderText="文字頻道按右鍵 → 複製頻道 ID"/>
                    <TextBlock Text="複製 ID 前，請先到 Discord 設定 → 進階 → 開啟開發者模式。"
                               TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Expander>

            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.SavedStatus, Mode=OneWay}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SavedStatus"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="音樂從 Windows 預設音訊裝置播放。背景分頁不代表帳號隔離；請使用獨立 Windows 使用者保護登入資料。"
                           TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
